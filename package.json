{
  "name": "pi-credential-pool",
  "version": "0.1.1",
  "description": "Multi-account OpenCode Go credential pool for Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cgaravitoq/pi-credential-pool.git"
  },
  "homepage": "https://github.com/cgaravitoq/pi-credential-pool#readme",
  "bugs": "https://github.com/cgaravitoq/pi-credential-pool/issues",
  "keywords": ["pi-package", "pi", "opencode", "opencode-go", "credentials"],
  "files": ["extensions", "scripts", "src", "README.md", "LICENSE"],
  "pi": {
    "extensions": ["./extensions/pi-credential-pool.ts"]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "check": "tsc --noEmit",
    "check:package": "npm pack --dry-run --json",
    "lint:slop": "oxlint -c oxlint.config.mts --deny-warnings",
    "test": "bun test",
    "smoke:opencode-go": "bun run scripts/live-smoke.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/bun": "^1.3.0",
    "oxlint": "1.82.0",
    "typescript": "^5.9.3",
    "ultracite": "7.11.1"
  }
}
